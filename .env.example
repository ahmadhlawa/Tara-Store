# ─────────────────────────────────────────────────────────────────────────────
# Tara Store — example local environment
#
# Copy the backend values to backend/.env and the VITE_* values to
# frontend/.env.local. Never commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Instance identity
APP_ENV=development
APP_NAME=Tara Store
CLIENT_SLUG=tara-store

# API
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
PUBLIC_BASE_URL=

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-secure-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Zero disables locally; production applies safe defaults when left at zero.
LOGIN_RATE_LIMIT=0
ORDER_CREATE_RATE_LIMIT=0
ORDER_LOOKUP_RATE_LIMIT=0
RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Database
# Local development and tests use SQLite; no database server is required.
DATABASE_URL=sqlite+pysqlite:///./data/tara_store_dev.db
# Future MySQL 8 deployment (one database and one user per client instance):
# DATABASE_URL=mysql+pymysql://commerce_user:replace-password@127.0.0.1:3306/commerce_database

# CORS — comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media storage
STORAGE_PROVIDER=local
LOCAL_MEDIA_ROOT=./data/tara-uploads
LOCAL_MEDIA_BASE_URL=/media
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_IMAGE_PIXELS=40000000

# Cloudflare R2 — adapter present but not activated; leave empty for local storage
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_OBJECT_PREFIX=

# Initial admin — only read by `python -m app.initial_data` and `python -m scripts.seed`.
# Leave empty and pass credentials on the command line if you prefer.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Store Owner

# Frontend (frontend/.env.local); omit when the backend uses port 8000.
# VITE_DEV_API_TARGET=http://127.0.0.1:8001
