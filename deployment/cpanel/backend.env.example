# Tara Store — backend production environment template
# Copy to the application root as `.env`, fill it on the server, and chmod 600.
# Whether the target cPanel supports Python 3.12 and ASGI remains to be confirmed.

APP_ENV=production
APP_NAME=Tara Store
API_V1_PREFIX=/api/v1
PUBLIC_BASE_URL=https://CLIENT_DOMAIN

# Generate on the server: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

LOGIN_RATE_LIMIT=10
ORDER_CREATE_RATE_LIMIT=10
ORDER_LOOKUP_RATE_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=60
# Set to the direct reverse-proxy address only.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# MySQL 8 URL; URL-encode reserved characters in the password.
DATABASE_URL=
CORS_ORIGINS=https://CLIENT_DOMAIN

STORAGE_PROVIDER=local
# Must be writable and persistent. For generic Nginx/systemd use ./data/uploads.
LOCAL_MEDIA_ROOT=./data/uploads
LOCAL_MEDIA_BASE_URL=/media
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_IMAGE_PIXELS=40000000

# Used only when STORAGE_PROVIDER=r2. Leave secrets blank until configured on-server.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_OBJECT_PREFIX=

# Prefer passing initial credentials directly to app.initial_data.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Tara Store Owner
