# ─────────────────────────────────────────────────────────────────────────────
# Vista Store — backend environment for a cPanel deployment
#
# Copy to the application root as `.env` and fill it in ON THE SERVER.
# NEVER commit the filled-in file. NEVER paste real secrets into chat, a ticket
# or a document.
#
# Every value marked PENDING comes from the cPanel capability answers. Until
# those arrive this file cannot be completed — see
# docs/deployment/cpanel-capability-checklist.md.
#
# WARNING: this file is a template, not a verified configuration. Whether a
# FastAPI application runs on the client's cPanel account at all is still an
# open question.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production
APP_NAME=Vista Store
API_V1_PREFIX=/api/v1

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate ON THE SERVER, once, and never reuse the development value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later signs every admin out. That is the intended behaviour if it
# is ever exposed.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Database ─────────────────────────────────────────────────────────────────
# PENDING — needs the MySQL host, database name, user and password from cPanel.
# cPanel usually forces an account prefix, so the real names look like
# `cpuser_vista` and `cpuser_vistauser`.
#
# Requires utf8mb4; the catalog, orders and invoices are Arabic throughout.
#
#   DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4
#
# The password must be URL-encoded if it contains @ : / ? # or %.
DATABASE_URL=

# ── CORS ─────────────────────────────────────────────────────────────────────
# PENDING — the final domain. Comma-separated, scheme included, no trailing
# slash. Do not use "*": it would let any site call this API from a browser.
#   CORS_ORIGINS=https://vista.example.com,https://www.vista.example.com
CORS_ORIGINS=

# ── Media ────────────────────────────────────────────────────────────────────
# PENDING — must be a directory that is WRITABLE and SURVIVES DEPLOYMENTS
# (checklist E2). If the host wipes it on deploy, every product image is lost
# and we must move to object storage before launch.
#
# Keep it OUTSIDE the document root and serve it through the app or an alias, so
# the directory cannot be listed over HTTP.
STORAGE_PROVIDER=local
LOCAL_MEDIA_ROOT=
LOCAL_MEDIA_BASE_URL=/media

# PENDING — must not exceed the host's own upload limit (checklist E4), or large
# uploads fail at the web server before the app ever sees them. 5 MB default.
MAX_UPLOAD_SIZE_BYTES=5242880

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# Not used. Out of scope for this engagement; leave every value empty.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# ── Initial admin ────────────────────────────────────────────────────────────
# Leave BLANK. Create the owner's account interactively, once, then delete any
# local development admin:
#   python -m app.initial_data --email owner@vista.example.com --password '<strong>'
# A password left in this file is a password in a file that gets copied around.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Vista Store Owner
