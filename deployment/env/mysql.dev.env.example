# Local MySQL development credentials — TEMPLATE.
#
#   copy deployment/env/mysql.dev.env.example .env.mysql.dev
#
# `.env.mysql.dev` is ignored by Git and must stay that way. Fill it with values you
# invent for this machine only.
#
# These credentials are for the throwaway container in compose.mysql.dev.yml. They are
# NOT the cPanel database credentials, NOT a production password, and must never be
# reused anywhere else. Nothing here is read by the application; the application reads
# DATABASE_URL from backend/.env.

MYSQL_ROOT_PASSWORD=replace-with-a-local-only-value
MYSQL_DATABASE=vista_dev
MYSQL_USER=vista_dev
MYSQL_PASSWORD=replace-with-a-local-only-value

# Host port. 3307 by default so it cannot collide with a MySQL already installed on
# this machine — this project must never connect to that one.
MYSQL_HOST_PORT=3307
