# ─────────────────────────────────────────────────────────────────────────────
# EXAMPLE ONLY — this server block is not installed or active anywhere.
#
# One site per client instance. Copy, replace every placeholder, review, then
# install as:  /etc/nginx/sites-available/commerce-CLIENT_SLUG.conf
#
#   CLIENT_SLUG   short lowercase client identifier   e.g. northwind
#   CLIENT_DOMAIN public domain for this instance     e.g. shop.example.com
#   BACKEND_PORT  loopback port of this instance's service   e.g. 8001
#   PROJECT_PATH  absolute path of this instance's checkout
#
# Serves three things:
#   1. the built SPA from frontend/dist, with a fallback so deep links work
#   2. /api  reverse-proxied to the FastAPI service on loopback
#   3. media is served directly by R2, never from this site's filesystem
#
# This file has never been installed on a server. Run `nginx -t` before reloading.
# ─────────────────────────────────────────────────────────────────────────────

log_format commerce_CLIENT_SLUG_json escape=json '{"time":"$time_iso8601","request_id":"$request_id",'
    '"remote_addr":"$remote_addr","method":"$request_method","uri":"$uri",'
    '"status":$status,"duration":$request_time}';

# Keep security headers inherited in every static location; per-location
# add_header directives would discard the server's header set.
map $uri $commerce_CLIENT_SLUG_cache_control {
    default "";
    ~^/assets/ "public, max-age=31536000, immutable";
    /index.html "no-cache, must-revalidate";
}

server {
    listen 80;
    listen [::]:80;
    server_name CLIENT_DOMAIN;

    # Serve the ACME challenge over plain HTTP, redirect everything else.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name CLIENT_DOMAIN;

    # TLS — issue a certificate for CLIENT_DOMAIN before enabling this site.
    ssl_certificate     /etc/letsencrypt/live/CLIENT_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/CLIENT_DOMAIN/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:commerce_CLIENT_SLUG_SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'" always;
    add_header Cache-Control $commerce_CLIENT_SLUG_cache_control always;

    # The API rejects oversized uploads itself (MAX_UPLOAD_SIZE_BYTES); keep this
    # at or slightly above that value so the error comes from the application.
    client_max_body_size 8m;

    access_log /var/log/nginx/commerce-CLIENT_SLUG.access.log commerce_CLIENT_SLUG_json;
    error_log  /var/log/nginx/commerce-CLIENT_SLUG.error.log;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ── 1. The built single-page application ────────────────────────────────
    root PROJECT_PATH/frontend/dist;
    index index.html;

    # Deep links such as /ar/product/<slug>, /en/checkout and /admin/orders are client-side
    # routes. Without this fallback they would 404 on reload.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Vite emits content-hashed asset filenames, so they can be cached hard.
    location /assets/ {
        try_files $uri =404;
    }

    # index.html must never be cached, or clients pin an old asset manifest.
    location = /index.html {
        try_files $uri =404;
    }

    # ── 2. The API ──────────────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://127.0.0.1:BACKEND_PORT;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Request-ID      $request_id;

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
        proxy_buffering off;
    }

    # Health check, outside the API prefix.
    location = /health {
        proxy_pass http://127.0.0.1:BACKEND_PORT/health;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        access_log off;
    }

    location = /ready {
        proxy_pass http://127.0.0.1:BACKEND_PORT/ready;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        access_log off;
    }

    location ~ ^/(robots\.txt|sitemap\.xml)$ {
        proxy_pass http://127.0.0.1:BACKEND_PORT$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
    }

    # ── 3. Uploaded media ───────────────────────────────────────────────────
    # Production media URLs point directly to R2_PUBLIC_BASE_URL, not local disk.
    location = /media { return 404; }
    location ^~ /media/ { return 404; }

    location ~ /\.(?!well-known) {
        deny all;
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# Install (run as root, after replacing the placeholders):
#
#   cp commerce-CLIENT_SLUG.conf /etc/nginx/sites-available/
#   ln -s /etc/nginx/sites-available/commerce-CLIENT_SLUG.conf \
#         /etc/nginx/sites-enabled/commerce-CLIENT_SLUG.conf
#   nginx -t && systemctl reload nginx
#
# Verify:
#   curl -I https://CLIENT_DOMAIN/
#   curl -I https://CLIENT_DOMAIN/ar/product/some-slug     # 200, not 404
#   curl    https://CLIENT_DOMAIN/api/v1/store/settings
#   curl -I <public-image-URL-from-R2_PUBLIC_BASE_URL>
#
# Login and public-order abuse limits are enforced by the application. Keep
# TRUSTED_PROXY_IPS restricted to this reverse proxy so client IPs are reliable.
# ─────────────────────────────────────────────────────────────────────────────
