[Unit]
Description=Prune expired Tara analytics (CLIENT_SLUG)
After=commerce-CLIENT_SLUG.service

[Service]
Type=oneshot
User=commerce-CLIENT_SLUG
Group=commerce-CLIENT_SLUG
WorkingDirectory=PROJECT_PATH/backend
EnvironmentFile=PROJECT_PATH/backend/.env
ExecStart=PROJECT_PATH/backend/.venv/bin/tara-analytics-prune --confirm --batch-size 1000
