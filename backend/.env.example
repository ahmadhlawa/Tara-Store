# Backend environment. Copy to backend/.env — never commit the real file.

APP_ENV=development
PUBLIC_BASE_URL=
APP_NAME=Tara Store
API_V1_PREFIX=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-secure-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Zero disables rate limiting for local development. Production automatically uses
# 10/10/60 per minute unless explicit positive values are supplied.
LOGIN_RATE_LIMIT=0
ORDER_CREATE_RATE_LIMIT=0
ORDER_LOOKUP_RATE_LIMIT=0
RATE_LIMIT_WINDOW_SECONDS=60
# X-Forwarded-For is honored only when the direct peer is in this list.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Local development and tests use SQLite; no database server is required.
# Tara's own local database, so this instance never shares another store's data.
DATABASE_URL=sqlite+pysqlite:///./data/tara_store_dev.db
# Future MySQL 8 deployment (one database and one user per client instance):
# DATABASE_URL=mysql+pymysql://commerce_user:replace-password@127.0.0.1:3306/commerce_database

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media stays on local disk for this client. R2 is out of scope here.
STORAGE_PROVIDER=local
# Tara's upload directory, ignored by Git. Runtime uploads never mix with the
# tracked seed/brand assets in backend/data/brand.
LOCAL_MEDIA_ROOT=./data/tara-uploads
LOCAL_MEDIA_BASE_URL=/media
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_IMAGE_PIXELS=40000000

# Cloudflare R2 — implemented, and inactive until STORAGE_PROVIDER=r2 above.
# Leave every value empty for local storage. Setting STORAGE_PROVIDER=r2 with any of
# the required values blank fails clearly when the provider is created.
# Needs the optional dependency:  pip install -e ".[r2]"
# Full setup: docs/deployment/r2-preview-setup.md
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
# Namespace for every object this instance writes. Deletes outside it are refused,
# so a bucket shared with anything else needs this set.
R2_OBJECT_PREFIX=

# Only read by `python -m app.initial_data` and `python -m scripts.seed`.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Store Owner
